#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        /* 006 / P0.06: одно нажатие стрелки вниз, даже если кнопку удерживать. */
        next_video_once: next_video_once {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <35>;
            tap-ms = <40>;
            bindings = <&kp DOWN>;
        };

        /* 008 / P0.08: двойной клик без заметного перемещения указателя. */
        like_double_click: like_double_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <40>;

            bindings
                = <&macro_tap &mkp LCLK>
                , <&macro_wait_time 95>
                , <&macro_tap &mkp LCLK>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";

        bt_clear_combo {
            timeout-ms = <100>;
            key-positions = <0 1>;
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &next_video_once            /* 006 / P0.06 — следующее видео */
                &like_double_click           /* 008 / P0.08 — лайк */
            >;
        };
    };
};
